{
  "name": "MaestroPro",
  "description": "AI-Powered Music Transcription & Arrangement by Maya Instruments Technology",
  "version": "1.1.0",
  "author": "Maya Instruments Technology",
  "license": "MIT",
  "main": "maestropro.qml",
  "type": "dock",
  "requiresScore": false,
  "museScoreVersion": "4.0.0",
  "museScoreVersionMax": "4.99.99",
  "permissions": [
    "network",
    "file-access"
  ],
  "backend": {
    "host": "localhost",
    "restPort": 8000,
    "websocketPort": 8765,
    "healthEndpoint": "/api/health",
    "transcribeEndpoint": "/api/transcribe",
    "analyzeEndpoint": "/api/analyze",
    "arrangeEndpoint": "/api/arrange",
    "compileSkillEndpoint": "/api/skills/compile",
    "listSkillsEndpoint": "/api/skills/list",
    "orchestrateSessionEndpoint": "/api/orchestrate/session",
    "orchestrateTranscribeEndpoint": "/api/orchestrate/transcribe",
    "orchestratePreviewEndpoint": "/api/orchestrate/preview",
    "orchestrateHealthEndpoint": "/api/orchestrate/health"
  },
  "features": [
    "Audio-to-MusicXML transcription",
    "YouTube/MP3 support",
    "Source separation (Demucs)",
    "Music theory analysis",
    "AI-powered arrangement",
    "Custom skill compilation",
    "SheetSage2 lead-sheet transcription",
    "YuE2 arrangement preview (human-in-the-loop)"
  ],
  "branding": {
    "tagline": "From Audio to Artistry",
    "primaryColor": "#1a3a52",
    "accentColor": "#d4af37"
  }
}
